#!/usr/bin/env python3
"""fleet - route coding tasks across Claude Code and Codex models.

The orchestrator (Fable in Claude Code, Astra in Codex) plans and reviews.
This tool does the dispatching: it picks a model for a task and shells out to
`claude -p` or `codex exec` to do the work, then hands back a JSON result.

Stdlib only. No network of its own.
"""

import argparse
import hashlib
import concurrent.futures as futures
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile
import threading
import time
import uuid
from datetime import datetime, timedelta, timezone
from pathlib import Path

__version__ = "1.3.0"

HERE = Path(__file__).resolve().parent
FLEET_HOME = Path(os.environ.get("FLEET_HOME", Path.home() / ".fleet"))
COMPLEXITIES = ["trivial", "low", "medium", "high", "extreme"]
TASK_ID_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9._-]{0,127}")

SESSIONS_LOCK = threading.Lock()


def sessions_path():
    return FLEET_HOME / "sessions.json"


def load_sessions():
    p = sessions_path()
    if p.is_file():
        try:
            return json.loads(p.read_text())
        except (json.JSONDecodeError, OSError):
            return {}
    return {}


def save_sessions(data):
    FLEET_HOME.mkdir(parents=True, exist_ok=True)
    tmp = sessions_path().with_name("sessions.json.tmp")
    tmp.write_text(json.dumps(data, indent=2))
    tmp.replace(sessions_path())


CLAUDE_PROJECTS = Path.home() / ".claude" / "projects"
CODEX_SESSIONS = Path.home() / ".codex" / "sessions"


def _norm_path(text):
    """Claude Code encodes a cwd into a directory name by replacing every
    non-alphanumeric character with '-', which is lossy - so we normalise both
    sides the same way and confirm against the cwd recorded inside the file."""
    return re.sub(r"[^A-Za-z0-9]", "-", str(text))


def _jsonl(path, limit=None):
    # Both CLIs write UTF-8; without an explicit encoding this follows the
    # platform locale and silently mis-decodes on non-UTF-8 systems.
    try:
        with open(path, encoding="utf-8", errors="replace") as fh:
            for i, line in enumerate(fh):
                if limit is not None and i >= limit:
                    return
                line = line.strip()
                if line.startswith("{"):
                    try:
                        yield json.loads(line)
                    except json.JSONDecodeError:
                        continue
    except OSError:
        return


def _message_text(obj, backend):
    """(role, text) for a real conversation message, else None.

    One definition shared by discovery and the digest, so a turn count means
    the same thing on both backends - Claude's transcript also files tool
    results under the `user` type, and those are not turns.
    """
    if backend == "claude":
        if obj.get("type") not in ("user", "assistant"):
            return None
        content = (obj.get("message") or {}).get("content")
        if isinstance(content, str):
            text = content
        elif isinstance(content, list):
            text = " ".join(c.get("text", "") for c in content
                            if isinstance(c, dict) and c.get("type") == "text")
        else:
            return None
        text = text.strip()
        return (obj["type"], text) if text else None

    if obj.get("type") != "response_item":
        return None
    pay = obj.get("payload") or {}
    if pay.get("type") != "message" or pay.get("role") not in ("user", "assistant"):
        return None
    text = " ".join(c.get("text", "") for c in pay.get("content", [])
                    if isinstance(c, dict) and c.get("text")).strip()
    return (pay["role"], text) if text else None


def _scan_transcript(path, backend, stop_after_cwd=False):
    """One pass over a transcript: title, cwd, turn count, opening ask.

    Everything the listing needs comes from a single read - scanning again per
    session would double the I/O of `fleet adopt`, which runs at every startup.
    `stop_after_cwd` is the cheap probe used to identify a directory.
    """
    title = cwd = first_ask = None
    turns = 0
    for obj in _jsonl(path):
        if stop_after_cwd and cwd:
            break
        if backend == "claude":
            t = obj.get("type")
            if t in ("custom-title", "ai-title"):
                title = obj.get("customTitle") or obj.get("aiTitle") or title
            if cwd is None and isinstance(obj.get("cwd"), str):
                cwd = obj["cwd"]
        elif obj.get("type") == "session_meta":
            pay = obj.get("payload") or {}
            cwd = cwd or pay.get("cwd")
        msg = _message_text(obj, backend)
        if not msg:
            continue
        role, text = msg
        turns += 1
        if first_ask is None and role == "user" and not _is_scaffolding(text):
            first_ask = " ".join(text.split())[:60]
    return {"title": title, "cwd": cwd, "turns": turns, "first_ask": first_ask}


CLAUDE_DIR_TRUNCATE = 200


def _claude_project_dirs(cwd):
    """Directories that might hold sessions for this cwd.

    Claude Code encodes a cwd by replacing non-alphanumerics with '-', but for
    long paths it truncates to 200 characters and appends a short hash, so an
    exact name match silently misses deep directories - worktrees and scratch
    dirs especially. Candidates are matched loosely here and confirmed against
    the cwd recorded inside the transcript.
    """
    if not CLAUDE_PROJECTS.is_dir():
        return []
    want = _norm_path(Path(cwd).resolve())
    dirs = [d for d in CLAUDE_PROJECTS.iterdir() if d.is_dir()]

    exact = [d for d in dirs if d.name == want]
    if exact:
        return exact
    if len(want) > CLAUDE_DIR_TRUNCATE:
        head = want[:CLAUDE_DIR_TRUNCATE]
        truncated = [d for d in dirs if d.name.startswith(head)]
        if truncated:
            return truncated
    # Last resort: the encoding changed. Ask the transcripts themselves.
    target = Path(cwd).resolve()
    matches = []
    for d in dirs:
        for f in d.glob("*.jsonl"):
            rec = _scan_transcript(f, "claude", stop_after_cwd=True)["cwd"]
            if rec:
                try:
                    if Path(rec).resolve() == target:
                        matches.append(d)
                except OSError:
                    pass
            break  # one file is enough to identify the directory
    return matches


def discover_claude_sessions(cwd):
    """Prior Claude Code sessions whose recorded cwd matches."""
    want_cwd = Path(cwd).resolve()
    found = []
    for d in _claude_project_dirs(cwd):
        for f in d.glob("*.jsonl"):
            info = _scan_transcript(f, "claude")
            if info["cwd"]:
                try:
                    if Path(info["cwd"]).resolve() != want_cwd:
                        continue
                except OSError:
                    continue
            found.append({
                "backend": "claude", "native_id": f.stem, "path": str(f),
                "title": info["title"] or info["first_ask"] or "(untitled)",
                "turns": info["turns"],
                "updated": datetime.fromtimestamp(f.stat().st_mtime, timezone.utc).isoformat(timespec="seconds"),
            })
    return found


def _codex_thread_names():
    """id -> human thread name, from Codex's own session index."""
    names = {}
    for obj in _jsonl(Path.home() / ".codex" / "session_index.jsonl"):
        if obj.get("id") and obj.get("thread_name"):
            names[obj["id"]] = obj["thread_name"]
    return names


def discover_codex_sessions(cwd):
    """Prior Codex sessions - each rollout file opens with a session_meta cwd.

    payload.id is this thread's own id and is what `codex exec resume` takes;
    payload.session_id is the root of the lineage and repeats across resumes,
    so it must not be used as the resume target.
    """
    want = Path(cwd).resolve()
    names = _codex_thread_names()
    found = []
    if not CODEX_SESSIONS.is_dir():
        return found
    for f in CODEX_SESSIONS.rglob("rollout-*.jsonl"):
        meta = None
        for obj in _jsonl(f, limit=3):
            if obj.get("type") == "session_meta":
                meta = obj.get("payload") or {}
                break
        if not meta or not meta.get("cwd"):
            continue
        try:
            if Path(meta["cwd"]).resolve() != want:
                continue
        except OSError:
            continue
        tid = meta.get("id") or meta.get("session_id")
        info = _scan_transcript(f, "codex")
        found.append({
            "backend": "codex", "native_id": tid, "path": str(f),
            "title": names.get(tid) or info["first_ask"] or "(untitled)",
            "turns": info["turns"], "root_id": meta.get("session_id"),
            "updated": datetime.fromtimestamp(f.stat().st_mtime, timezone.utc).isoformat(timespec="seconds"),
        })
    return found


def discover_sessions(cwd):
    all_found = discover_claude_sessions(cwd) + discover_codex_sessions(cwd)
    return sorted(all_found, key=lambda x: x["updated"], reverse=True)


SCAFFOLD_PREFIXES = (
    "<recommended_plugins", "<app-context", "<environment_context", "<system-reminder",
    "<ide_context", "<user-prompt-submit-hook", "<command-name", "<local-command",
    "caveat: the messages below were generated",
    "the following is the codex agent history",
    "this session is being continued from a previous conversation",
)


def _is_scaffolding(text):
    """Harness-injected context, not anything a person said."""
    head = text.strip()[:120].lower()
    return any(head.startswith(pfx) for pfx in SCAFFOLD_PREFIXES)


def transcript_digest(entry, max_chars=12000):
    """Flatten a transcript to plain text so the other CLI can pick up context.

    A Claude session cannot literally be resumed inside Codex (or the reverse),
    so a cross-CLI handoff carries the conversation as text instead.
    """
    parts = []
    for obj in _jsonl(entry["path"]):
        msg = _message_text(obj, entry["backend"])
        if not msg:
            continue
        role, text = msg
        if not _is_scaffolding(text):
            parts.append("%s: %s" % (role.upper(), text))

    text = "\n\n".join(parts)
    if len(text) > max_chars:
        head = text[: max_chars // 3]
        tail = text[-(max_chars * 2 // 3):]
        text = head + "\n\n[... middle of the transcript omitted ...]\n\n" + tail
    return text


def resume_hint(backend, native_id):
    """The command that opens this worker's conversation interactively.

    Delegations run headless, but they are real sessions in each CLI's own
    store - so every one of them can be opened and read afterwards.
    """
    if not native_id:
        return None
    if backend == "claude":
        return "claude --resume %s" % native_id
    return "codex resume %s" % native_id


def parse_codex_thread_id(stdout):
    """codex --json emits a thread.started event carrying the thread id."""
    for line in stdout.splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            o = json.loads(line)
        except json.JSONDecodeError:
            continue
        tid = o.get("thread_id") or (o.get("thread") or {}).get("id")
        if tid:
            return tid
    return None


def codex_text_from_events(stdout):
    """Last assistant message out of the JSONL event stream."""
    texts = []
    for line in stdout.splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            o = json.loads(line)
        except json.JSONDecodeError:
            continue
        if o.get("type") == "item.completed":
            item = o.get("item") or {}
            if item.get("item_type") == "assistant_message" and item.get("text"):
                texts.append(item["text"])
    return texts[-1] if texts else ""


AUTH_FIX = {
    "claude": "run `claude` interactively once, or `claude auth login`",
    "codex":  "open the Codex/ChatGPT app and sign in, or `codex login`",
}


# ---------------------------------------------------------------- roster ----

def load_roster():
    candidates = []
    if os.environ.get("FLEET_ROSTER"):
        candidates.append(Path(os.environ["FLEET_ROSTER"]))
    candidates += [
        Path.cwd() / ".fleet" / "roster.json",
        FLEET_HOME / "roster.json",
        HERE.parent / "roster.json",
    ]
    for c in candidates:
        if c.is_file():
            with open(c) as fh:
                r = json.load(fh)
            r["_source"] = str(c)
            return r
    die("no roster.json found (looked in %s)" % ", ".join(str(c) for c in candidates))


def die(msg, code=2):
    print("fleet: %s" % msg, file=sys.stderr)
    sys.exit(code)


def validate_task_id(tid):
    """Reject a task id that is unsafe as an artifact filename."""
    if not isinstance(tid, str) or not TASK_ID_RE.fullmatch(tid):
        raise ValueError(
            "invalid task id %r (use 1-128 letters, numbers, dots, underscores, or hyphens; "
            "the first character must be a letter or number)" % tid
        )


def validate_task_ids(tasks):
    """Reject task ids that are ambiguous or unsafe as artifact filenames."""
    seen = set()
    for task in tasks:
        tid = task.get("id")
        validate_task_id(tid)
        # macOS and Windows are case-insensitive by default, so ids differing
        # only in case would collide on disk and silently overwrite a result.
        key = tid.casefold()
        if key in seen:
            raise ValueError(
                "duplicate task id %r (ids are compared case-insensitively because "
                "artifact files collide on case-insensitive filesystems)" % tid)
        seen.add(key)


def decisions_block(plan):
    """Carry the orchestrator's reasoning to the workers, not just its conclusions.

    A delegate is a fresh process: without this it receives an instruction with
    no rationale, which is how delegated work drifts from what was intended.
    """
    parts = []
    context = str(plan.get("context") or "").strip()
    if context:
        parts.append("## Background\n\n" + context)

    decisions = plan.get("decisions") or []
    if isinstance(decisions, str):
        decisions = [decisions]
    items = [str(d).strip() for d in decisions if str(d).strip()]
    if items:
        parts.append(
            "## Decisions already made\n\n"
            "These are settled. Work within them rather than re-opening them. If one "
            "turns out to be impossible, stop and say so instead of quietly choosing "
            "something else.\n\n" + "\n".join("- " + i for i in items))

    if not parts:
        return ""
    return ("# Context from the orchestrator\n\n" + "\n\n".join(parts)
            + "\n\n---\n\n# Your task\n\n")


def validate_plan(plan):
    """Check a plan's shape, fill in default ids, and return its tasks.

    Raises ValueError with a human-readable message rather than letting a
    malformed plan surface as a KeyError or AttributeError traceback.
    """
    if not isinstance(plan, dict):
        raise ValueError("plan must be a JSON object, got %s" % type(plan).__name__)
    tasks = plan.get("tasks")
    if not isinstance(tasks, list) or not tasks:
        raise ValueError('plan needs a non-empty "tasks" array (see examples/ in the repo)')
    if "decisions" in plan and not isinstance(plan["decisions"], (list, str)):
        raise ValueError('plan "decisions" must be a list of strings (or one string)')
    if "context" in plan and not isinstance(plan["context"], str):
        raise ValueError('plan "context" must be a string')
    for i, t in enumerate(tasks):
        if not isinstance(t, dict):
            raise ValueError("task %d must be an object, got %s" % (i + 1, type(t).__name__))
        if not isinstance(t.get("prompt"), str) or not t["prompt"].strip():
            raise ValueError('task %d needs a non-empty "prompt"' % (i + 1))
        t.setdefault("id", "t%d" % (i + 1))
    validate_task_ids(tasks)
    return tasks


def sanitize_label(label):
    """Run labels are cosmetic, so scrub them rather than rejecting the run."""
    cleaned = re.sub(r"[^A-Za-z0-9._-]+", "-", str(label)).strip("-.")
    return cleaned[:48] or "run"


def task_artifact_path(run_dir, task_id, suffix):
    """Build a task artifact path and enforce containment as defense in depth."""
    root = Path(run_dir).resolve()
    candidate = (root / (task_id + suffix)).resolve()
    if candidate.parent != root:
        raise ValueError("task artifact path escapes run directory: %r" % task_id)
    return candidate


def backend_bin(roster, backend):
    """Resolve a backend's executable, or None if not installed."""
    spec = roster["backends"].get(backend)
    if not spec:
        return None
    env_override = os.environ.get("FLEET_%s_BIN" % backend.upper())
    for cand in ([env_override] if env_override else []) + [spec["bin"]] + spec.get("bin_fallbacks", []):
        if not cand:
            continue
        cand = os.path.expanduser(os.path.expandvars(cand))
        if os.path.sep in cand:
            found = cand if os.access(cand, os.X_OK) else None
        else:
            found = shutil.which(cand)
        if found:
            return found
    return None


def available_backends(roster):
    return {b: backend_bin(roster, b) for b in roster["backends"] if backend_bin(roster, b)}


# --------------------------------------------------------------- routing ----

def route(roster, kind, complexity, prefer="auto", avoid_backend=None):
    """Deterministic policy: (kind, complexity) -> tier -> concrete model."""
    table = roster["routing"]
    if kind not in table:
        kind = "implement"
    if complexity not in COMPLEXITIES:
        complexity = "medium"
    tier = table[kind][complexity]

    avail = available_backends(roster)
    # With nothing installed we still answer policy questions (`fleet route`),
    # so the matrix can be inspected before committing to an install. Actually
    # dispatching still fails loudly, in build_cmd().
    policy_only = not avail

    order = []
    if prefer and prefer != "auto":
        order.append(prefer)
    # Balance: default the non-preferred choice by what's installed.
    order += [b for b in ("claude", "codex") if b not in order]
    if avoid_backend:
        order = [b for b in order if b != avoid_backend] + [b for b in order if b == avoid_backend]

    def usable(backend):
        return policy_only or backend in avail

    defaults = roster["tier_defaults"][tier]
    for backend in order:
        if usable(backend) and defaults.get(backend):
            return defaults[backend], tier
    # Tier unavailable on any installed backend - fall back down the tiers.
    tiers = roster["tier_order"]
    idx = tiers.index(tier)
    for t in tiers[idx::-1] + tiers[idx:]:
        for backend in order:
            if usable(backend) and roster["tier_defaults"][t].get(backend):
                return roster["tier_defaults"][t][backend], t
    die("no model available for tier %s" % tier)


def resolve_model(roster, key):
    models = roster["models"]
    if key in models:
        return key, models[key]
    # Allow raw ids too (e.g. "gpt-5.6-sol").
    for k, m in models.items():
        if m["id"] == key:
            return k, m
    die("unknown model %r (known: %s)" % (key, ", ".join(sorted(models))))


# ------------------------------------------------------------- execution ----

def build_cmd(roster, model, cwd, effort, readonly, yolo, outfile, session=None):
    """session: None, {} for a brand-new named session, or a dict with native_id."""
    backend = model["backend"]
    exe = backend_bin(roster, backend)
    if not exe:
        return None, "backend %s is not installed - run `fleet doctor` to see what resolves" % backend
    resume_id = (session or {}).get("native_id")

    if backend == "claude":
        cmd = [exe, "-p", "--model", model["id"], "--output-format", "json"]
        if resume_id:
            cmd += ["--resume", resume_id]
        elif session is not None:
            cmd += ["--session-id", session.setdefault("native_id", str(uuid.uuid4()))]
        if effort:
            cmd += ["--effort", effort]
        if readonly:
            cmd += ["--permission-mode", "dontAsk",
                    "--disallowed-tools", "Edit", "Write", "NotebookEdit"]
        elif yolo:
            cmd += ["--dangerously-skip-permissions"]
        else:
            cmd += ["--permission-mode", "acceptEdits"]
        cmd += ["--add-dir", cwd]
        return cmd, None

    if backend == "codex":
        sandbox = "read-only" if readonly else "workspace-write"
        if resume_id:
            # `exec resume` takes a smaller flag set: no -s and no -C, so the
            # sandbox goes through a config override and cwd via the subprocess.
            cmd = [exe, "exec", "resume", resume_id, "-", "-m", model["id"],
                   "--skip-git-repo-check", "--json", "-o", outfile]
            if not readonly and yolo:
                cmd += ["--dangerously-bypass-approvals-and-sandbox"]
            else:
                cmd += ["-c", 'sandbox_mode="%s"' % sandbox]
        else:
            cmd = [exe, "exec", "-", "-m", model["id"], "-C", cwd,
                   "--skip-git-repo-check", "--json", "-o", outfile]
            if readonly:
                cmd += ["-s", sandbox]
            elif yolo:
                cmd += ["--dangerously-bypass-approvals-and-sandbox"]
            else:
                cmd += ["-s", sandbox]
        if effort:
            cmd += ["-c", "model_reasoning_effort=%s" % effort]
        return cmd, None

    return None, "unknown backend %s" % backend


def extract_text(backend, stdout, outfile):
    if backend == "codex":
        try:
            txt = Path(outfile).read_text().strip()
            if txt:
                return txt
        except OSError:
            pass
        from_events = codex_text_from_events(stdout)
        if from_events:
            return from_events
        return stdout.strip()[-8000:]
    # claude --output-format json
    try:
        obj = json.loads(stdout)
        if isinstance(obj, dict):
            return obj.get("result") or json.dumps(obj)[:8000]
    except (json.JSONDecodeError, TypeError):
        pass
    return stdout.strip()[-8000:]


def claude_meta(stdout):
    try:
        obj = json.loads(stdout)
        if isinstance(obj, dict):
            return {k: obj[k] for k in ("total_cost_usd", "num_turns", "duration_ms", "session_id", "is_error")
                    if k in obj}
    except (json.JSONDecodeError, TypeError):
        pass
    return {}


def run_task(roster, task, run_dir, cwd, timeout, yolo, prefer, verbose=False):
    """Execute one task dict. Returns a result dict."""
    tid = task.get("id") or uuid.uuid4().hex[:8]
    id_error = None
    try:
        validate_task_id(tid)
    except ValueError as e:
        id_error = str(e)
    model_key = task.get("model")
    tier = None
    if model_key:
        model_key, _ = resolve_model(roster, model_key)
        tier = roster["models"][model_key]["tier"]
    else:
        model_key, tier = route(roster, task.get("kind", "implement"),
                                task.get("complexity", "medium"),
                                prefer=task.get("prefer", prefer),
                                avoid_backend=task.get("avoid_backend"))
    model = roster["models"][model_key]
    readonly = bool(task.get("readonly"))
    task_cwd = task.get("cwd") or cwd

    # A named session is a persistent conversation with one model on one
    # backend. Resuming pins the model - you cannot continue a conversation
    # somewhere it never happened.
    sess_name = task.get("session")
    session, session_error, resumed = None, None, False
    if sess_name:
        with SESSIONS_LOCK:
            existing = load_sessions().get(sess_name)
        if existing:
            if task.get("model") and task["model"] != existing["model"]:
                session_error = (
                    "session %r is pinned to %s (%s); refusing to resume it as %r. "
                    "Use a different --session name, or `fleet sessions --forget %s`."
                    % (sess_name, existing["model"], existing["backend"],
                       task["model"], sess_name))
            else:
                model_key = existing["model"]
                model = roster["models"][model_key]
                tier = model["tier"]
                session = dict(existing)
                resumed = bool(session.get("native_id"))
        else:
            session = {"name": sess_name, "backend": model["backend"],
                       "model": model_key, "cwd": task_cwd,
                       "created": datetime.now(timezone.utc).isoformat(), "turns": 0}

    effort = task.get("effort") or roster["effort"].get(tier)

    outfile = None if id_error else str(task_artifact_path(run_dir, tid, ".last.txt"))
    cmd, err = (None, None) if (id_error or session_error) else build_cmd(
        roster, model, task_cwd, effort, readonly, yolo, outfile, session=session)

    def shell(**over):
        """Every result carries the same keys, so callers never KeyError."""
        base = {"id": tid, "ok": False, "model": model_key, "model_id": model["id"],
                "backend": model["backend"], "tier": tier, "effort": effort,
                "kind": task.get("kind"), "complexity": task.get("complexity"),
                "readonly": readonly, "cwd": task_cwd, "seconds": 0.0,
                "exit_code": None, "timed_out": False, "output": "",
                "session": sess_name, "resumed": resumed}
        base.update(over)
        return base

    if id_error:
        # Deliberately writes no artifact: the id is the very thing we cannot
        # trust as a filename. Callers still get the usual result shape.
        return shell(exit_code=2, error=id_error, stderr=id_error)

    if session_error:
        res = shell(exit_code=2, error=session_error, stderr=session_error)
        task_artifact_path(run_dir, tid, ".json").write_text(json.dumps(res, indent=2))
        return res

    if err:
        res = shell(exit_code=127, error=err, stderr=err)
        task_artifact_path(run_dir, tid, ".json").write_text(json.dumps(res, indent=2))
        return res

    prompt = task["prompt"]
    started = time.time()
    if verbose:
        print("  -> [%s] %s (%s/%s)%s" % (tid, model_key, model["backend"], tier,
                                          "  resume:%s" % sess_name if resumed else
                                          ("  new session:%s" % sess_name if sess_name else "")),
              file=sys.stderr)
    try:
        proc = subprocess.run(cmd, input=prompt, capture_output=True, text=True,
                              timeout=timeout, cwd=task_cwd)
        stdout, stderr, rc = proc.stdout, proc.stderr, proc.returncode
        timed_out = False
    except subprocess.TimeoutExpired:
        stdout, stderr, rc, timed_out = "", "timed out after %ss" % timeout, 124, True
    except OSError as e:
        stdout, stderr, rc, timed_out = "", str(e), 127, False

    elapsed = round(time.time() - started, 1)
    text = extract_text(model["backend"], stdout, outfile)
    result = {
        "id": tid,
        "ok": rc == 0 and not timed_out,
        "model": model_key,
        "model_id": model["id"],
        "backend": model["backend"],
        "tier": tier,
        "effort": effort,
        "kind": task.get("kind"),
        "complexity": task.get("complexity"),
        "readonly": readonly,
        "cwd": task_cwd,
        "seconds": elapsed,
        "exit_code": rc,
        "timed_out": timed_out,
        "output": text,
        "prompt": prompt[:4000] + ("\n... [truncated]" if len(prompt) > 4000 else ""),
    }
    if model["backend"] == "claude":
        result["meta"] = claude_meta(stdout)
    if rc != 0:
        result["stderr"] = stderr.strip()[-4000:]

    result["session"] = sess_name
    result["resumed"] = resumed

    # Every delegation leaves a real session behind; record its id so the
    # conversation can be opened later, named session or not.
    if model["backend"] == "claude":
        native = (result.get("meta") or {}).get("session_id")
    else:
        native = parse_codex_thread_id(stdout)
    native = native or (session or {}).get("native_id")
    result["native_id"] = native
    result["resume_with"] = resume_hint(model["backend"], native)

    if session is not None:
        if native and result["ok"]:
            session["native_id"] = native
            session["turns"] = session.get("turns", 0) + 1
            session["last_used"] = datetime.now(timezone.utc).isoformat()
            with SESSIONS_LOCK:
                allsess = load_sessions()
                allsess[sess_name] = session
                save_sessions(allsess)
        result["session_native_id"] = native

    task_artifact_path(run_dir, tid, ".json").write_text(json.dumps(result, indent=2))
    return result


# ----------------------------------------------------------------- ledger ----

def new_run_dir(label="run"):
    """The label comes from an untrusted plan file, so contain it here - that
    keeps every write inside the run dir safe by construction rather than
    relying on each call site to remember task_artifact_path()."""
    stamp = datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")
    root = (FLEET_HOME / "runs").resolve()
    name = "%s-%s-%s" % (stamp, sanitize_label(label), uuid.uuid4().hex[:6])
    d = (root / name).resolve()
    if d.parent != root:
        die("run directory escapes %s (label %r)" % (root, label))
    d.mkdir(parents=True, exist_ok=True)
    return d


# ------------------------------------------------------------------ waves ----

def plan_waves(tasks):
    """Topologically group tasks into dependency waves."""
    by_id = {t["id"]: t for t in tasks}
    done, waves, remaining = set(), [], list(tasks)
    while remaining:
        wave = [t for t in remaining if all(d in done for d in t.get("deps", []))]
        if not wave:
            unmet = {t["id"]: [d for d in t.get("deps", []) if d not in done and d not in by_id]
                     for t in remaining}
            die("dependency cycle or unknown deps: %s" % json.dumps(unmet))
        waves.append(wave)
        done |= {t["id"] for t in wave}
        remaining = [t for t in remaining if t["id"] not in done]
    return waves


# --------------------------------------------------------------- commands ----

def cmd_doctor(args):
    roster = load_roster()
    print("roster:      %s" % roster["_source"])
    print("fleet home:  %s" % FLEET_HOME)
    ok = False
    for b in roster["backends"]:
        path = backend_bin(roster, b)
        if path:
            try:
                ver = subprocess.run([path] + roster["backends"][b].get("probe", ["--version"]),
                                     capture_output=True, text=True, timeout=30).stdout.strip()
            except Exception as e:
                ver = "(probe failed: %s)" % e
            print("  [ok]      %-7s %s  -- %s" % (b, path, ver.splitlines()[0] if ver else "?"))
            ok = True
        else:
            print("  [missing] %-7s not on PATH" % b)
    if not ok:
        print("\nNo backends found. Install Claude Code and/or the Codex CLI.")
        return 1
    print("\nModels reachable:")
    avail = available_backends(roster)
    for k, m in roster["models"].items():
        mark = "ok " if m["backend"] in avail else "-- "
        print("  %s %-8s %-7s %-9s %s" % (mark, k, m["backend"], m["tier"], m["id"]))

    if getattr(args, "auth", False):
        print("\nLive auth probe (one trivial prompt per backend):")
        healthy = True
        with tempfile.TemporaryDirectory() as td:
            for b in avail:
                key = roster["tier_defaults"]["light"].get(b)
                if not key:
                    continue
                task = {"id": "probe-%s" % b, "prompt": "Reply with exactly: PONG",
                        "model": key, "readonly": True}
                r = run_task(roster, task, td, td, 120, False, "auto")
                blob = (r.get("output", "") + " " + r.get("stderr", "")).lower()
                if r["ok"] and "pong" in r.get("output", "").upper().lower():
                    print("  [ok]      %-7s %s responded (%ss)" % (b, key, r["seconds"]))
                elif "oauth" in blob or "401" in blob or "authenticate" in blob:
                    healthy = False
                    print("  [AUTH]    %-7s token expired. Fix: %s" % (b, AUTH_FIX.get(b, "re-login")))
                else:
                    healthy = False
                    print("  [FAIL]    %-7s %s" % (b, (r.get("output") or r.get("stderr") or "no output").strip()[:160]))
        if not healthy:
            print("\nDelegation to a failing backend will error at run time.")
            return 1
    return 0


def cmd_models(args):
    roster = load_roster()
    avail = available_backends(roster)
    if args.json:
        print(json.dumps({k: dict(v, available=v["backend"] in avail)
                          for k, v in roster["models"].items()}, indent=2))
        return 0
    for tier in reversed(roster["tier_order"]):
        print("\n%s" % tier.upper())
        for k, m in roster["models"].items():
            if m["tier"] == tier:
                print("  %-8s %-7s %-30s %s%s" % (
                    k, m["backend"], m["id"], m.get("blurb", ""),
                    "" if m["backend"] in avail else "   [backend not installed]"))
    return 0


def cmd_route(args):
    roster = load_roster()
    if args.all:
        print("%-12s %s" % ("kind", "  ".join("%-10s" % c for c in COMPLEXITIES)))
        for kind in roster["routing"]:
            if kind.startswith("_"):
                continue
            cells = []
            for c in COMPLEXITIES:
                mk, _ = route(roster, kind, c, prefer=args.prefer)
                cells.append("%-10s" % mk)
            print("%-12s %s" % (kind, "  ".join(cells)))
        return 0
    model_key, tier = route(roster, args.kind, args.complexity, prefer=args.prefer)
    m = roster["models"][model_key]
    out = {"model": model_key, "tier": tier, "backend": m["backend"], "model_id": m["id"],
           "effort": roster["effort"].get(tier)}
    print(json.dumps(out, indent=2) if args.json else
          "%s  (%s, tier=%s, effort=%s)" % (model_key, m["backend"], tier, out["effort"]))
    return 0


def read_prompt(args):
    if args.prompt_file:
        return Path(args.prompt_file).read_text()
    if args.prompt and args.prompt != "-":
        return args.prompt
    return sys.stdin.read()


def cmd_run(args):
    roster = load_roster()
    cwd = str(Path(args.cwd or os.getcwd()).resolve())
    task = {
        "id": args.id or "t1",
        "prompt": read_prompt(args),
        "kind": args.kind,
        "complexity": args.complexity,
        "model": args.model,
        "readonly": args.readonly,
        "effort": args.effort,
        "cwd": cwd,
        "session": args.session,
    }
    try:
        validate_task_ids([task])
    except ValueError as e:
        die(str(e))
    run_dir = new_run_dir("run")
    res = run_task(roster, task, run_dir, cwd, args.timeout, args.yolo, args.prefer,
                   verbose=not args.json)
    goal = " ".join(task["prompt"].split())[:120] or args.kind
    single = {"cwd": cwd, "goal": goal, "run_dir": str(run_dir), "results": [res]}
    (run_dir / "run.json").write_text(json.dumps(single, indent=2))
    write_receipt(single, run_dir, cwd)
    if args.json:
        print(json.dumps(res, indent=2))
    else:
        tag = ""
        if res.get("session"):
            tag = "  [session %s%s]" % (res["session"], ", resumed" if res.get("resumed") else ", new")
        print("\n--- %s via %s (%s, %ss)%s ---" % (res["id"], res["model"], res["backend"], res["seconds"], tag))
        print(res["output"])
        if res.get("resume_with"):
            print("\nopen this conversation:  %s" % res["resume_with"], file=sys.stderr)
        if not res["ok"]:
            print("\n[FAILED rc=%s] %s" % (res["exit_code"], res.get("stderr", "")), file=sys.stderr)
    print("\nledger: %s" % run_dir, file=sys.stderr)
    return 0 if res["ok"] else 1


def cmd_batch(args):
    roster = load_roster()
    plan = json.load(open(args.plan)) if args.plan != "-" else json.load(sys.stdin)
    cwd = str(Path(plan.get("cwd") or args.cwd or os.getcwd()).resolve())
    try:
        tasks = validate_plan(plan)
    except ValueError as e:
        die(str(e))
    preamble = decisions_block(plan)
    if preamble:
        carried = 0
        for t in tasks:
            if t.get("inherit_decisions", True):
                t["prompt"] = preamble + t["prompt"]
                carried += 1
        print("fleet: carrying the orchestrator's context into %d of %d task(s)"
              % (carried, len(tasks)), file=sys.stderr)

    run_dir = new_run_dir(plan.get("label", "batch"))
    Path(run_dir, "plan.json").write_text(json.dumps(plan, indent=2))

    maxpar = args.max_parallel or roster["defaults"]["max_parallel"]
    waves = plan_waves(tasks)
    print("fleet: %d task(s) in %d wave(s), up to %d in parallel"
          % (len(tasks), len(waves), maxpar), file=sys.stderr)

    results, prior = [], {}
    for wi, wave in enumerate(waves, 1):
        print("\nwave %d/%d (%d task(s))" % (wi, len(waves), len(wave)), file=sys.stderr)
        for t in wave:
            if t.get("deps") and t.get("inherit_context", True):
                ctx = "\n\n".join(
                    "## Result of upstream task %s (%s)\n%s" % (d, prior[d]["model"], prior[d]["output"])
                    for d in t["deps"] if d in prior)
                if ctx:
                    t["prompt"] = t["prompt"] + "\n\n---\n# Context from completed upstream tasks\n" + ctx
        with futures.ThreadPoolExecutor(max_workers=maxpar) as ex:
            futs = {ex.submit(run_task, roster, t, run_dir, cwd, args.timeout,
                              args.yolo, args.prefer, True): t for t in wave}
            for f in futures.as_completed(futs):
                r = f.result()
                prior[r["id"]] = r
                results.append(r)
                print("  %s [%s] %s in %ss%s" % (
                    "ok  " if r["ok"] else "FAIL", r["model"], r["id"], r["seconds"],
                    ("   open: " + r["resume_with"]) if r.get("resume_with") else ""),
                    file=sys.stderr)

    summary = {"cwd": cwd, "goal": plan.get("goal"), "run_dir": str(run_dir),
               "context": plan.get("context"), "decisions": plan.get("decisions"),
               "results": results}
    Path(run_dir, "run.json").write_text(json.dumps(summary, indent=2))
    rec = write_receipt(summary, run_dir, cwd)
    if rec:
        print("receipt: %s" % rec, file=sys.stderr)
    if args.json:
        print(json.dumps(summary, indent=2))
    else:
        for r in results:
            print("\n===== %s | %s (%s, tier=%s, %ss) =====" % (r["id"], r["model"], r["backend"], r["tier"], r["seconds"]))
            print(r["output"] if r["ok"] else "[FAILED] %s" % r.get("stderr", ""))
    print("\nledger: %s" % run_dir, file=sys.stderr)
    return 0 if all(r["ok"] for r in results) else 1


def _nb_id():
    """nbformat 4.5+ requires a per-cell id; without it validation warns today
    and fails outright on newer versions."""
    return uuid.uuid4().hex[:8]


def _nb_md(text):
    return {"id": _nb_id(), "cell_type": "markdown", "metadata": {},
            "source": text.splitlines(keepends=True)}


def _nb_code(source, output=None):
    outs = []
    if output:
        outs = [{"output_type": "stream", "name": "stdout",
                 "text": output.splitlines(keepends=True)}]
    return {"id": _nb_id(), "cell_type": "code", "execution_count": None, "metadata": {},
            "outputs": outs, "source": source.splitlines(keepends=True)}


def _fence(text, limit=4000):
    """A receipt is evidence, so the content is never edited to fit. Pick a
    fence longer than the longest backtick run rather than altering the text."""
    text = (text or "").strip()
    if len(text) > limit:
        text = text[:limit] + "\n... [truncated]"
    longest = max((len(m) for m in re.findall(r"`+", text)), default=0)
    fence = "`" * max(3, longest + 1)
    return fence + "\n" + text + "\n" + fence


def git_snapshot(cwd):
    def run(*args):
        try:
            r = subprocess.run(args, cwd=cwd, capture_output=True, text=True, timeout=20)
            return r.stdout.strip() if r.returncode == 0 else None
        except (OSError, subprocess.SubprocessError):
            return None
    branch = run("git", "rev-parse", "--abbrev-ref", "HEAD")
    if not branch:
        return None
    return {"branch": branch, "head": (run("git", "rev-parse", "--short", "HEAD") or "?"),
            "diffstat": run("git", "diff", "--stat")}


def build_receipt(summary, git_info=None):
    """A notebook receipt: what was asked, who did it, and what changed.

    Emitted as plain .ipynb JSON, so it needs no notebook libraries installed.
    """
    results = summary.get("results", [])
    ok = sum(1 for r in results if r.get("ok"))
    cells = [_nb_md(
        "# Task receipt\n\n"
        "**Goal:** %s\n\n"
        "- **Run:** `%s`\n"
        "- **Working directory:** `%s`\n"
        "- **Generated:** %s\n"
        "- **Outcome:** %d of %d task(s) succeeded\n"
        % (summary.get("goal") or "(not stated)",
           Path(summary.get("run_dir", "?")).name,
           summary.get("cwd", "?"),
           datetime.now(timezone.utc).isoformat(timespec="seconds"),
           ok, len(results)))]

    if git_info:
        cells.append(_nb_md(
            "## Repository state\n\n- **Branch:** `%s`\n- **HEAD:** `%s`\n\n%s\n"
            % (git_info.get("branch", "?"), git_info.get("head", "?"),
               _fence(git_info.get("diffstat") or "(no uncommitted changes)"))))

    decisions = summary.get("decisions") or []
    if isinstance(decisions, str):
        decisions = [decisions]
    if summary.get("context") or decisions:
        body = ""
        if summary.get("context"):
            body += str(summary["context"]).strip() + "\n\n"
        if decisions:
            body += "\n".join("- " + str(d).strip() for d in decisions if str(d).strip())
        cells.append(_nb_md("## Decisions carried into this work\n\n" + body + "\n"))

    cells.append(_nb_md("## Delegations\n\nOne section per task, in completion order."))
    for r in results:
        cells.append(_nb_md(
            "### `%s` - %s\n\n"
            "| field | value |\n|---|---|\n"
            "| model | `%s` (`%s`) |\n| backend | %s |\n| tier | %s |\n"
            "| kind / complexity | %s / %s |\n| read-only | %s |\n"
            "| session | %s |\n| duration | %ss |\n| result | %s |\n"
            "| open the conversation | %s |\n"
            % (r.get("id"), "ok" if r.get("ok") else "FAILED",
               r.get("model"), r.get("model_id"), r.get("backend"), r.get("tier"),
               r.get("kind") or "-", r.get("complexity") or "-",
               "yes" if r.get("readonly") else "no",
               r.get("session") or "-", r.get("seconds"),
               "success" if r.get("ok") else "exit %s" % r.get("exit_code"),
               ("`%s`" % r["resume_with"]) if r.get("resume_with") else "-")))
        if r.get("prompt"):
            cells.append(_nb_md("**Prompt sent**\n\n" + _fence(r["prompt"])))
        cells.append(_nb_md("**Response**\n\n"
                            + _fence(r.get("output") or r.get("stderr") or "(no output)")))

    cells.append(_nb_md(
        "## Verification\n\n"
        "_Record what was actually run to check this work - tests, a linter, a manual "
        "check - and paste the real output below. A receipt with no verification is a "
        "claim, not evidence._"))
    cells.append(_nb_code("# e.g. !python -m unittest discover -s tests", None))

    return {"cells": cells, "nbformat": 4, "nbformat_minor": 5,
            "metadata": {"kernelspec": {"display_name": "Python 3", "language": "python",
                                        "name": "python3"},
                         "language_info": {"name": "python"},
                         "fleet": {"run_dir": summary.get("run_dir"),
                                   "generated": datetime.now(timezone.utc).isoformat()}}}


def write_receipt(summary, run_dir, cwd):
    """Best effort - a receipt failure must never take down the run itself."""
    try:
        nb = build_receipt(summary, git_snapshot(cwd))
        path = Path(run_dir) / "receipt.ipynb"
        path.write_text(json.dumps(nb, indent=1))
        return path
    except Exception as e:  # noqa: BLE001
        print("fleet: could not write receipt (%s)" % e, file=sys.stderr)
        return None


TASK_ROOT = ".fleet/tasks"
UNDERSTANDING_TEMPLATE = """# What this change is, in plain language

<!-- Written for a person who was not here. No jargon, no model names, no task ids.
     If a sentence would not survive being read aloud to a new teammate, rewrite it. -->

## What was asked for

## What actually changed

## Why it was done this way

_What alternatives were considered, and why this one won._

## What could go wrong

_Known limits, anything deliberately left out, what to watch after merge._

## How it was checked

_The actual commands run and what they showed._
"""


def _git(cwd, *args):
    """git reports failures on stderr, so returning stdout alone loses every
    error message - and any caller branching on the text sees an empty string."""
    try:
        r = subprocess.run(("git",) + args, cwd=cwd, capture_output=True, text=True, timeout=30)
        out = r.stdout.strip() or r.stderr.strip()
        return (out, r.returncode)
    except (OSError, subprocess.SubprocessError) as e:
        return (str(e), 1)


def _repo_root(cwd):
    out, rc = _git(cwd, "rev-parse", "--show-toplevel")
    return Path(out) if rc == 0 else None


def _task_dir(root, slug):
    return Path(root) / TASK_ROOT / slug


def _load_task(root, slug):
    f = _task_dir(root, slug) / "task.json"
    try:
        return json.loads(f.read_text())
    except (OSError, json.JSONDecodeError):
        return None


def _save_task(root, slug, data):
    d = _task_dir(root, slug)
    d.mkdir(parents=True, exist_ok=True)
    (d / "task.json").write_text(json.dumps(data, indent=2))


def _runs_under(root):
    """Runs whose recorded cwd is inside this repository, oldest first.

    The receipt is the evidence a task gate demands, so a run from an unrelated
    project must never be able to satisfy it.
    """
    runs_dir = FLEET_HOME / "runs"
    if not runs_dir.is_dir():
        return []
    root = Path(root).resolve()
    out = []
    for r in sorted(runs_dir.glob("*")):
        try:
            summary = json.loads(Path(r, "run.json").read_text())
        except (OSError, json.JSONDecodeError):
            continue
        if not summary.get("cwd"):
            continue
        try:
            run_cwd = Path(summary["cwd"]).resolve()
        except OSError:
            continue
        if run_cwd == root or root in run_cwd.parents:
            out.append((r, summary))
    return out


def task_gates(root, slug):
    """The four gates, each independently checkable. No gate is self-reported.

    Merge is the outcome of passing them, not a gate - nothing here may be
    satisfied by simply asserting it."""
    d = _task_dir(root, slug)
    meta = _load_task(root, slug) or {}
    branch_now, _ = _git(root, "rev-parse", "--abbrev-ref", "HEAD")

    understanding = d / "understanding.md"
    u_text = understanding.read_text() if understanding.is_file() else ""
    # Strip whole comment blocks: a per-line prefix filter let the middle lines
    # of the template's guidance comment count as the author's own prose.
    u_text = re.sub(r"<!--.*?-->", "", u_text, flags=re.S)
    u_body = "\n".join(l for l in u_text.splitlines()
                       if l.strip() and not l.strip().startswith(("#", "_")))

    receipt = d / "receipt.ipynb"
    cell_count = 0
    if receipt.is_file():
        try:
            nb = json.loads(receipt.read_text())
            if nb.get("metadata", {}).get("fleet"):  # must be a fleet-generated receipt
                cell_count = len(nb.get("cells", []))
        except (OSError, json.JSONDecodeError):
            cell_count = 0

    review = meta.get("review") or {}
    return [
        {"gate": "branch", "ok": bool(meta.get("branch")) and branch_now == meta.get("branch"),
         "detail": "on %s (task branch %s)" % (branch_now or "?", meta.get("branch") or "-")},
        {"gate": "receipt", "ok": cell_count > 0,
         "detail": ("%s (%d cells)" % (receipt.name, cell_count)) if receipt.is_file()
                   else "missing"},
        {"gate": "review", "ok": review.get("verdict") == "pass",
         "detail": ("%s by %s" % (review.get("verdict"), review.get("by", "?")))
                   if review else "not reviewed"},
        {"gate": "understanding", "ok": understanding.is_file() and len(u_body) >= 200,
         "detail": ("%d chars of prose" % len(u_body)) if understanding.is_file()
                   else "missing"},
    ]


def cmd_task(args):
    cwd = str(Path(args.cwd or os.getcwd()).resolve())
    root = _repo_root(cwd)
    if not root:
        die("not inside a git repository - this workflow is branch-based")

    if args.task_cmd == "list":
        base = Path(root) / TASK_ROOT
        slugs = sorted(p.name for p in base.iterdir()) if base.is_dir() else []
        if not slugs:
            print("no tasks yet.  start one:  fleet task start <slug>")
            return 0
        for sl in slugs:
            gates = task_gates(root, sl)
            done = sum(1 for g in gates if g["ok"])
            print("  %-28s %d/%d gates  %s" % (sl, done, len(gates),
                  "READY TO MERGE" if done == len(gates) else
                  "blocked: " + ", ".join(g["gate"] for g in gates if not g["ok"])))
        return 0

    slug = args.slug
    if not slug:
        die("which task? e.g. fleet task %s add-rate-limiting" % args.task_cmd)
    if not TASK_ID_RE.fullmatch(slug):
        die("invalid task slug %r (letters, numbers, dots, underscores, hyphens)" % slug)

    if args.task_cmd == "start":
        branch = args.branch or ("fleet/%s" % slug)
        # fleet's own task artifacts always leave the tree dirty, so they must
        # not block starting the next task.
        dirty_raw, _ = _git(root, "status", "--porcelain")
        dirty = [l for l in dirty_raw.splitlines()
                 if l.strip() and TASK_ROOT not in l and not l.split(maxsplit=1)[-1].startswith(".fleet/")]
        if dirty and not args.allow_dirty:
            die("working tree has uncommitted changes; commit or stash first "
                "(or pass --allow-dirty):\n  " + "\n  ".join(dirty[:5]))
        base_branch, _ = _git(root, "rev-parse", "--abbrev-ref", "HEAD")
        out, rc = _git(root, "checkout", "-b", branch)
        if rc != 0 and "already exists" in out.lower():
            out, rc = _git(root, "checkout", branch)
        if rc != 0:
            die("could not switch to %s: %s" % (branch, out))
        meta = {"slug": slug, "branch": branch, "base": base_branch,
                "started": datetime.now(timezone.utc).isoformat(timespec="seconds")}
        _save_task(root, slug, meta)
        u = _task_dir(root, slug) / "understanding.md"
        if not u.is_file():
            u.write_text(UNDERSTANDING_TEMPLATE)
        print("task %r started" % slug)
        print("  branch:        %s (from %s)" % (branch, base_branch))
        print("  understanding: %s  <- fill this in, in plain language" % u.relative_to(root))
        print("\nNext:  do the work, then  fleet task receipt %s" % slug)
        return 0

    meta = _load_task(root, slug)
    if not meta:
        die("no task %r (start it with: fleet task start %s)" % (slug, slug))

    if args.task_cmd == "receipt":
        candidates = _runs_under(root)
        if not candidates:
            die("no fleet run recorded in %s yet - delegate some work first.\n"
                "  (runs from other projects are deliberately not offered: the receipt "
                "is this task's evidence)" % root)
        if args.run:
            picked = [(r, sm) for r, sm in candidates if args.run in r.name]
            if not picked:
                die("no run matching %r in this repository.\n  available: %s"
                    % (args.run, ", ".join(r.name for r, _ in candidates[-5:])))
            target, summary = picked[-1]
        else:
            target, summary = candidates[-1]
        summary.setdefault("run_dir", str(target))
        nb = build_receipt(summary, git_snapshot(root))
        out = _task_dir(root, slug) / "receipt.ipynb"
        out.parent.mkdir(parents=True, exist_ok=True)
        out.write_text(json.dumps(nb, indent=1))
        meta["receipt_from"] = target.name
        _save_task(root, slug, meta)
        print("receipt attached: %s  (from run %s)" % (out.relative_to(root), target.name))
        return 0

    if args.task_cmd == "review":
        if not args.verdict:
            die("record the orchestrator's verdict: --verdict pass|changes")
        meta["review"] = {"verdict": args.verdict, "by": args.by or "orchestrator",
                          "notes": args.notes or "",
                          "at": datetime.now(timezone.utc).isoformat(timespec="seconds")}
        _save_task(root, slug, meta)
        print("review recorded: %s by %s" % (args.verdict, meta["review"]["by"]))
        if args.verdict != "pass":
            print("  gate stays closed until the verdict is 'pass'")
        return 0

    if args.task_cmd == "status":
        gates = task_gates(root, slug)
        print("task %r  (branch %s, from %s)\n" % (slug, meta.get("branch"), meta.get("base")))
        for g in gates:
            print("  [%s] %-14s %s" % ("x" if g["ok"] else " ", g["gate"], g["detail"]))
        blocked = [g["gate"] for g in gates if not g["ok"]]
        print()
        if blocked:
            print("NOT ready to merge - open gates: %s" % ", ".join(blocked))
            return 1
        print("All gates passed. Merge with:")
        print("  git checkout %s && git merge --no-ff %s" % (meta.get("base"), meta.get("branch")))
        return 0

    die("unknown task command %r" % args.task_cmd)


def cmd_receipt(args):
    runs_dir = FLEET_HOME / "runs"
    runs = sorted(runs_dir.glob("*")) if runs_dir.is_dir() else []
    if not runs:
        die("no runs recorded yet")
    if args.run in (None, "latest"):
        target = runs[-1]
    else:
        target = next((r for r in runs if args.run in r.name), None)
        if not target:
            die("no run matching %r" % args.run)
    try:
        summary = json.loads(Path(target, "run.json").read_text())
    except (OSError, json.JSONDecodeError) as e:
        die("run %s has no readable run.json (%s)" % (target.name, e))
    summary.setdefault("run_dir", str(target))
    nb = build_receipt(summary, git_snapshot(summary.get("cwd") or os.getcwd()))
    out = Path(args.out) if args.out else Path(target) / "receipt.ipynb"
    out.parent.mkdir(parents=True, exist_ok=True)
    out.write_text(json.dumps(nb, indent=1))
    print("receipt: %s (%d cells, %d task(s))"
          % (out, len(nb["cells"]), len(summary.get("results", []))))
    return 0


QUEUE_STATES = ("pending", "claimed", "done", "failed", "cancelled")
DEFAULT_POLL_SECONDS = 300
DEFAULT_LEASE_SECONDS = 1800


def queue_dir():
    d = FLEET_HOME / "queue" / "tasks"
    d.mkdir(parents=True, exist_ok=True)
    return d


def worker_dir():
    d = FLEET_HOME / "queue" / "workers"
    d.mkdir(parents=True, exist_ok=True)
    return d


def _now():
    return datetime.now(timezone.utc)


def _iso(dt=None):
    return (dt or _now()).isoformat(timespec="seconds")


def _pid_alive(pid):
    """A dead owner is how we tell a crash from slow work."""
    try:
        os.kill(int(pid), 0)
    except (OSError, TypeError, ValueError):
        return False
    return True


def _write_atomic(path, data):
    tmp = Path(str(path) + ".tmp")
    tmp.write_text(json.dumps(data, indent=2))
    tmp.replace(path)


def load_queue_task(tid):
    try:
        return json.loads((queue_dir() / ("%s.json" % tid)).read_text())
    except (OSError, json.JSONDecodeError):
        return None


def all_queue_tasks(cwd=None, states=None):
    out = []
    for f in sorted(queue_dir().glob("*.json")):
        if f.name.endswith(".tmp"):
            continue
        try:
            t = json.loads(f.read_text())
        except (OSError, json.JSONDecodeError):
            continue
        if states and t.get("state") not in states:
            continue
        if cwd and t.get("cwd") != cwd:
            continue
        out.append(t)
    out.sort(key=lambda t: (-int(t.get("priority", 0)), t.get("created", "")))
    return out


def notify(title, message):
    """Notification Center holds these while the screen is locked."""
    if os.environ.get("FLEET_NOTIFY", "1") == "0":
        return
    try:
        subprocess.run(
            ["osascript", "-e", "display notification %s with title %s"
             % (json.dumps(message[:200]), json.dumps(title[:80]))],
            capture_output=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        pass


def reap_stale(cwd=None, verbose=False):
    """Reclaim tasks whose owner died or whose lease expired.

    This is the crash recovery: a claim is only good while its owner is alive
    and keeps beating, so an interrupted session releases its work by itself.
    """
    reclaimed = []
    for t in all_queue_tasks(cwd=cwd, states=("claimed",)):
        lease = t.get("lease") or {}
        expires = lease.get("expires_at", "")
        # Timestamps are second-granularity, so a lease that runs out in this
        # very second is already over.
        expired = bool(expires) and expires <= _iso()

        # Liveness is the heartbeat, not the process that made the claim: the
        # claiming CLI invocation exits immediately, and treating that as a
        # crash would reclaim work while the session is still doing it - the
        # duplicate execution this queue exists to prevent. A pid is only
        # consulted when the caller supplied a long-lived one.
        owner_pid = lease.get("pid")
        owner_dead = owner_pid is not None and not _pid_alive(owner_pid)

        if not expired and not owner_dead:
            continue
        why = "owner pid %s gone" % owner_pid if owner_dead else "lease expired at %s" % expires
        t["state"] = "pending"
        t["lease"] = None
        t.setdefault("history", []).append(
            {"at": _iso(), "event": "reclaimed", "why": why})
        _write_atomic(queue_dir() / ("%s.json" % t["id"]), t)
        reclaimed.append(t["id"])
        if verbose:
            print("  reclaimed %s (%s)" % (t["id"], t["history"][-1]["why"]), file=sys.stderr)
    return reclaimed


def _worker_is_live(record):
    """A worker holds its slot by re-attaching, within a grace of two polls.

    An explicitly supplied long-lived pid short-circuits this: if that process
    is gone the slot is free immediately.
    """
    if record.get("owner_pid") is not None:
        return _pid_alive(record["owner_pid"])
    poll = int(record.get("poll_seconds") or DEFAULT_POLL_SECONDS)
    try:
        seen = datetime.fromisoformat(record["attached_at"])
    except (KeyError, ValueError, TypeError):
        return False
    return (_now() - seen).total_seconds() < poll * 2 + 60


def cmd_enqueue(args):
    cwd = str(Path(args.cwd or os.getcwd()).resolve())
    key = args.key or hashlib.sha256(
        ("%s\n%s" % (cwd, args.prompt.strip())).encode("utf-8")).hexdigest()[:16]

    # Idempotency: the same work must not queue twice.
    for t in all_queue_tasks(cwd=cwd, states=("pending", "claimed")):
        if t.get("key") == key:
            print("already queued as %s (%s) - not adding a duplicate"
                  % (t["id"], t["state"]))
            return 0

    tid = _now().strftime("%Y%m%dT%H%M%S") + "-" + uuid.uuid4().hex[:6]
    task = {
        "id": tid, "key": key, "state": "pending", "cwd": cwd,
        "prompt": args.prompt, "kind": args.kind, "complexity": args.complexity,
        "priority": args.priority, "label": args.label,
        "created": _iso(), "attempts": 0, "lease": None,
        "history": [{"at": _iso(), "event": "enqueued"}],
    }
    _write_atomic(queue_dir() / ("%s.json" % tid), task)
    print("queued %s  (%s)" % (tid, args.label or args.kind))
    print("  the attached session will pick it up on its next poll")
    return 0


def _claim(task, worker, lease_seconds, owner_pid=None):
    """Atomic claim via O_EXCL - two workers cannot take the same task."""
    lock = queue_dir() / ("%s.claim" % task["id"])
    try:
        fd = os.open(str(lock), os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
    except FileExistsError:
        return None
    try:
        os.write(fd, ("%s\n%d\n" % (worker, os.getpid())).encode())
    finally:
        os.close(fd)

    fresh = load_queue_task(task["id"])
    if not fresh or fresh.get("state") != "pending":
        lock.unlink(missing_ok=True)
        return None
    fresh["state"] = "claimed"
    fresh["attempts"] = int(fresh.get("attempts", 0)) + 1
    fresh["lease"] = {
        "worker": worker,
        # Only a caller-supplied, long-lived pid is worth watching; this
        # process is about to exit.
        "pid": owner_pid,
        "claimed_at": _iso(),
        "expires_at": _iso(_now() + timedelta(seconds=lease_seconds)),
    }
    fresh.setdefault("history", []).append(
        {"at": _iso(), "event": "claimed", "worker": worker})
    _write_atomic(queue_dir() / ("%s.json" % fresh["id"]), fresh)
    lock.unlink(missing_ok=True)
    return fresh


def cmd_queue(args):
    cwd = str(Path(args.cwd or os.getcwd()).resolve())
    sub = args.queue_cmd

    if sub == "next":
        reap_stale(cwd=cwd)
        worker = args.worker or ("pid-%d" % os.getpid())
        for candidate in all_queue_tasks(cwd=cwd, states=("pending",)):
            got = _claim(candidate, worker, args.lease, owner_pid=args.owner_pid)
            if got:
                print(json.dumps(got, indent=2))
                return 0
        if args.json:
            print(json.dumps({"task": None}))
        else:
            print("nothing pending for %s" % cwd)
        return 0

    if sub in ("done", "fail", "cancel"):
        if not args.id:
            die("which task? e.g. fleet queue %s <id>" % sub)
        t = load_queue_task(args.id)
        if not t:
            die("no queued task %r" % args.id)
        state = {"done": "done", "fail": "failed", "cancel": "cancelled"}[sub]
        t["state"] = state
        t["lease"] = None
        t["finished"] = _iso()
        if args.summary:
            t["summary"] = args.summary
        if args.error:
            t["error"] = args.error
        t.setdefault("history", []).append({"at": _iso(), "event": state})
        _write_atomic(queue_dir() / ("%s.json" % t["id"]), t)
        print("%s -> %s" % (t["id"], state))
        if sub != "cancel":
            notify("Fleet: task %s" % state,
                   (args.summary or args.error or t.get("label") or t["prompt"])[:180])
        return 0

    if sub == "beat":
        if not args.id:
            die("which task?")
        t = load_queue_task(args.id)
        if not t or t.get("state") != "claimed":
            die("task %r is not claimed" % args.id)
        t["lease"]["expires_at"] = _iso(_now() + timedelta(seconds=args.lease))
        _write_atomic(queue_dir() / ("%s.json" % t["id"]), t)
        print("lease extended to %s" % t["lease"]["expires_at"])
        return 0

    if sub == "reap":
        got = reap_stale(cwd=cwd, verbose=True)
        print("reclaimed %d task(s)" % len(got))
        return 0

    if sub == "attach":
        # One drainer per project. Holding the slot is proved by re-attaching
        # each poll, not by a live pid: this process exits immediately, so a
        # pid check would let a second controller straight in.
        wf = worker_dir() / (_norm_path(cwd)[:120] + ".json")
        me = args.worker or "foreground"
        cur = None
        try:
            cur = json.loads(wf.read_text())
        except (OSError, json.JSONDecodeError):
            pass

        if cur and cur.get("session") != me and not args.force:
            held = _worker_is_live(cur)
            if held:
                die("a worker is already attached to this project: %s (last seen %s).\n"
                    "  It is already draining - starting a second one would run tasks twice.\n"
                    "  Use --force only if it is wedged." % (cur.get("session"), cur.get("attached_at")))

        _write_atomic(wf, {"pid": os.getpid(), "session": me, "owner_pid": args.owner_pid,
                           "cwd": cwd, "attached_at": _iso(), "poll_seconds": args.poll})
        print("attached to %s as %r" % (cwd, me))
        print("  poll every %ds; re-attach each poll to hold the slot" % args.poll)
        print("  drain loop:  /loop %dm fleet queue next --json" % max(1, args.poll // 60))
        return 0

    if sub == "status":
        counts = {}
        for t in all_queue_tasks(cwd=None if args.all else cwd):
            counts[t.get("state", "?")] = counts.get(t.get("state", "?"), 0) + 1
        print("queue: %s" % (", ".join("%s=%d" % kv for kv in sorted(counts.items())) or "empty"))
        wf = worker_dir() / (_norm_path(cwd)[:120] + ".json")
        if wf.is_file():
            try:
                w = json.loads(wf.read_text())
                live = _worker_is_live(w)
                print("worker: %s - %s (last seen %s, poll %ss)"
                      % (w.get("session"),
                         "holding the slot" if live
                         else "stale, the slot is free to take",
                         w.get("attached_at"), w.get("poll_seconds")))
            except (OSError, json.JSONDecodeError):
                pass
        else:
            print("worker: none attached (`fleet queue attach`)")
        return 0

    # list
    states = None if args.all else ("pending", "claimed")
    tasks = all_queue_tasks(cwd=None if args.all else cwd, states=states)
    if not tasks:
        print("nothing queued.  add one:  fleet enqueue \"...\"")
        return 0
    print("  %-22s %-9s %-4s %-8s %s" % ("ID", "STATE", "TRY", "PRIO", "LABEL / PROMPT"))
    for t in tasks:
        print("  %-22s %-9s %-4s %-8s %s" % (
            t["id"], t.get("state"), t.get("attempts", 0), t.get("priority", 0),
            (t.get("label") or " ".join(t.get("prompt", "").split()))[:46]))
    return 0


def cmd_adopt(args):
    """Pick up an existing project conversation from either CLI."""
    roster = load_roster()
    cwd = str(Path(args.cwd or os.getcwd()).resolve())
    found = discover_sessions(cwd)

    if not found:
        print("No prior Claude Code or Codex sessions found for %s" % cwd)
        return 0

    if not args.id:
        print("Prior sessions for %s\n" % cwd)
        print("  %-3s %-7s %-38s %-6s %-20s %s" % ("#", "CLI", "SESSION ID", "TURNS", "UPDATED", "TITLE"))
        for i, e in enumerate(found, 1):
            print("  %-3d %-7s %-38s %-6s %-20s %s" % (
                i, e["backend"], e["native_id"], e["turns"], e["updated"][:19], e["title"][:44]))
        print("\nResume it here:      fleet adopt %s --as work" % found[0]["native_id"][:8])
        print("Hand it to the other CLI:  fleet adopt %s --as work --handoff sonnet"
              % found[0]["native_id"][:8])
        return 0

    matches = [e for e in found if e["native_id"].startswith(args.id)]
    if args.id.isdigit() and 1 <= int(args.id) <= len(found):
        matches = [found[int(args.id) - 1]]
    if not matches:
        die("no session here matching %r (run `fleet adopt` to list)" % args.id)
    if len(matches) > 1:
        die("%r matches %d sessions; use more characters" % (args.id, len(matches)))
    entry = matches[0]

    if args.digest_only:
        print(transcript_digest(entry, args.max_chars))
        return 0

    name = args.as_name or ("adopted-%s" % entry["native_id"][:8])

    if args.handoff:
        # Cross-CLI: the conversation cannot be resumed natively on the other
        # side, so carry it across as text and open a fresh session there.
        model_key, _ = resolve_model(roster, args.handoff)
        digest = transcript_digest(entry, args.max_chars)
        if not digest.strip():
            die("that session has no readable transcript to hand off")
        prompt = (
            "You are picking up a project already in progress. The transcript below is an "
            "earlier %s session in this same working directory (%s). Read it as context for "
            "what has already been decided, tried, and built.\n\n"
            "Reply with a short summary of where the work stands and what you understand the "
            "next step to be. Do not change any files yet.\n\n"
            "===== EARLIER %s TRANSCRIPT =====\n%s\n===== END TRANSCRIPT ====="
            % (entry["backend"], cwd, entry["backend"].upper(), digest))
        run_dir = new_run_dir("adopt")
        task = {"id": "handoff", "prompt": prompt, "model": model_key,
                "session": name, "readonly": True, "cwd": cwd}
        print("Handing a %s session (%d turns) to %s ..."
              % (entry["backend"], entry["turns"], model_key), file=sys.stderr)
        res = run_task(roster, task, run_dir, cwd, args.timeout, False, "auto", verbose=True)
        print("\n%s" % res["output"])
        if not res["ok"]:
            print("[FAILED] %s" % res.get("stderr", ""), file=sys.stderr)
            return 1
        print("\nSession %r now continues that work. Next: fleet run \"...\" --session %s"
              % (name, name), file=sys.stderr)
        return 0

    # Same CLI: adopt the native id so `--session NAME` resumes it for real.
    model_key = args.model or roster["tier_defaults"]["mid"].get(entry["backend"])
    model_key, _ = resolve_model(roster, model_key)
    if roster["models"][model_key]["backend"] != entry["backend"]:
        die("session is a %s session; %r runs on %s. Use --handoff to cross CLIs."
            % (entry["backend"], model_key, roster["models"][model_key]["backend"]))
    with SESSIONS_LOCK:
        allsess = load_sessions()
        allsess[name] = {"name": name, "backend": entry["backend"], "model": model_key,
                         "cwd": cwd, "native_id": entry["native_id"],
                         "created": datetime.now(timezone.utc).isoformat(),
                         "turns": entry["turns"], "adopted_from": entry["path"]}
        save_sessions(allsess)
    print("Adopted %s session %s as %r (model %s)."
          % (entry["backend"], entry["native_id"][:12], name, model_key))
    print('Continue it with:  fleet run "next instruction" --session %s' % name)
    return 0


def cmd_sessions(args):
    with SESSIONS_LOCK:
        data = load_sessions()

    if args.forget_all:
        with SESSIONS_LOCK:
            save_sessions({})
        print("forgot %d session(s)" % len(data))
        return 0

    if args.forget:
        if args.forget not in data:
            die("no session named %r" % args.forget)
        with SESSIONS_LOCK:
            d = load_sessions()
            d.pop(args.forget, None)
            save_sessions(d)
        print("forgot session %r" % args.forget)
        return 0

    if args.json:
        print(json.dumps(data, indent=2))
        return 0

    if not data:
        print("no named sessions yet.\n"
              "Start one:  fleet run \"...\" --session mywork --cwd /path/to/repo")
        return 0

    print("%-14s %-8s %-7s %-6s %-20s %s" % ("NAME", "MODEL", "BACKEND", "TURNS", "LAST USED", "OPEN WITH"))
    for name, sess in sorted(data.items()):
        hint = resume_hint(sess.get("backend"), sess.get("native_id")) or "-"
        print("%-14s %-8s %-7s %-6s %-20s %s" % (
            name[:14], sess.get("model", "?"), sess.get("backend", "?"),
            sess.get("turns", 0), (sess.get("last_used") or "-")[:19], hint))
    print("\nContinue headless:  fleet run \"next instruction\" --session <NAME>")
    print("Read it yourself:   run the OPEN WITH command above")
    return 0


def cmd_ledger(args):
    runs = sorted((FLEET_HOME / "runs").glob("*")) if (FLEET_HOME / "runs").is_dir() else []
    if args.show:
        target = next((r for r in runs if args.show in r.name), None)
        if not target:
            die("no run matching %r" % args.show)
        print(Path(target, "run.json").read_text())
        return 0
    for r in runs[-(args.limit):]:
        try:
            data = json.loads(Path(r, "run.json").read_text())
            n = len(data.get("results", []))
            bad = sum(1 for x in data.get("results", []) if not x["ok"])
            models = ",".join(sorted({x["model"] for x in data.get("results", [])}))
            print("%-46s %2d task(s) %s  [%s]" % (r.name, n, "%d failed" % bad if bad else "all ok", models))
        except (OSError, json.JSONDecodeError):
            print("%-46s (incomplete)" % r.name)
    return 0


def main():
    p = argparse.ArgumentParser(prog="fleet", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("-V", "--version", action="version", version="fleet %s" % __version__)
    sub = p.add_subparsers(dest="cmd", required=True)

    d = sub.add_parser("doctor", help="show which backends and models are reachable")
    d.add_argument("--auth", action="store_true", help="also send one trivial prompt per backend to verify credentials")
    d.set_defaults(fn=cmd_doctor)

    m = sub.add_parser("models", help="list the roster")
    m.add_argument("--json", action="store_true")
    m.set_defaults(fn=cmd_models)

    r = sub.add_parser("route", help="ask the policy which model fits a task")
    r.add_argument("--kind", default="implement")
    r.add_argument("--complexity", default="medium", choices=COMPLEXITIES)
    r.add_argument("--prefer", default="auto", choices=["auto", "claude", "codex"])
    r.add_argument("--all", action="store_true", help="print the whole routing matrix")
    r.add_argument("--json", action="store_true")
    r.set_defaults(fn=cmd_route)

    def common(sp):
        sp.add_argument("--cwd")
        sp.add_argument("--timeout", type=int, default=1800)
        sp.add_argument("--prefer", default="auto", choices=["auto", "claude", "codex"])
        sp.add_argument("--yolo", action="store_true", help="skip sandbox/permission checks")
        sp.add_argument("--json", action="store_true")

    x = sub.add_parser("run", help="delegate a single task")
    x.add_argument("prompt", nargs="?", help="prompt text, or - for stdin")
    x.add_argument("--prompt-file")
    x.add_argument("--id")
    x.add_argument("--model", help="force a model (bypasses routing)")
    x.add_argument("--kind", default="implement")
    x.add_argument("--complexity", default="medium", choices=COMPLEXITIES)
    x.add_argument("--effort")
    x.add_argument("--readonly", action="store_true", help="no edits: review/research mode")
    x.add_argument("--session", help="named persistent session: created on first use, resumed after")
    common(x)
    x.set_defaults(fn=cmd_run)

    b = sub.add_parser("batch", help="run a plan.json of tasks with deps, in parallel waves")
    b.add_argument("plan", help="path to plan JSON, or - for stdin")
    b.add_argument("--max-parallel", type=int)
    common(b)
    b.set_defaults(fn=cmd_batch)

    eq = sub.add_parser("enqueue", help="add a task for the attached foreground session")
    eq.add_argument("prompt")
    eq.add_argument("--cwd")
    eq.add_argument("--key", help="idempotency key (defaults to a hash of cwd + prompt)")
    eq.add_argument("--kind", default="implement")
    eq.add_argument("--complexity", default="medium", choices=COMPLEXITIES)
    eq.add_argument("--priority", type=int, default=0, help="higher runs first")
    eq.add_argument("--label", help="short name shown in listings and notifications")
    eq.set_defaults(fn=cmd_enqueue)

    q = sub.add_parser("queue", help="inspect and drain the foreground task queue")
    q.add_argument("queue_cmd", nargs="?", default="list",
                   choices=["list", "next", "done", "fail", "cancel", "beat",
                            "reap", "attach", "status"])
    q.add_argument("id", nargs="?")
    q.add_argument("--cwd")
    q.add_argument("--worker", help="name recorded as the claim owner")
    q.add_argument("--owner-pid", type=int,
                   help="a long-lived pid to watch; if it dies the claim is released "
                        "immediately instead of waiting for the lease to expire")
    q.add_argument("--lease", type=int, default=DEFAULT_LEASE_SECONDS,
                   help="seconds a claim stays valid without a heartbeat")
    q.add_argument("--poll", type=int, default=DEFAULT_POLL_SECONDS,
                   help="seconds between polls (default %d)" % DEFAULT_POLL_SECONDS)
    q.add_argument("--summary", help="what was done (shown in the notification)")
    q.add_argument("--error", help="why it failed")
    q.add_argument("--all", action="store_true", help="every project, every state")
    q.add_argument("--force", action="store_true", help="take over a wedged worker slot")
    q.add_argument("--json", action="store_true")
    q.set_defaults(fn=cmd_queue)

    tk = sub.add_parser("task", help="branch -> receipt -> review -> understanding -> merge")
    tk.add_argument("task_cmd", choices=["start", "receipt", "review", "status", "list"])
    tk.add_argument("slug", nargs="?")
    tk.add_argument("--branch", help="branch name (default fleet/<slug>)")
    tk.add_argument("--base", help="base branch to merge back into")
    tk.add_argument("--run", help="fleet run to build the receipt from (default: latest)")
    tk.add_argument("--verdict", choices=["pass", "changes"], help="orchestrator review outcome")
    tk.add_argument("--by", help="who reviewed (e.g. fable, astra)")
    tk.add_argument("--notes", help="review notes")
    tk.add_argument("--allow-dirty", action="store_true")
    tk.add_argument("--cwd")
    tk.set_defaults(fn=cmd_task)

    rc_ = sub.add_parser("receipt", help="write a notebook receipt for a run")
    rc_.add_argument("--run", help="run id substring, or 'latest' (default)")
    rc_.add_argument("--out", help="output path (default: receipt.ipynb inside the run dir)")
    rc_.set_defaults(fn=cmd_receipt)

    ad = sub.add_parser("adopt", help="pick up an existing Claude Code or Codex session for this project")
    ad.add_argument("id", nargs="?", help="session id prefix, or the row number from the listing")
    ad.add_argument("--as", dest="as_name", metavar="NAME", help="name to file it under")
    ad.add_argument("--handoff", metavar="MODEL",
                    help="carry the transcript to the OTHER CLI and open a session there")
    ad.add_argument("--model", help="model to resume with (same-CLI adoption)")
    ad.add_argument("--digest-only", action="store_true", help="just print the transcript digest")
    ad.add_argument("--max-chars", type=int, default=12000, help="transcript budget (default 12000)")
    ad.add_argument("--cwd")
    ad.add_argument("--timeout", type=int, default=900)
    ad.set_defaults(fn=cmd_adopt)

    ss = sub.add_parser("sessions", help="list or forget named sessions")
    ss.add_argument("--forget", metavar="NAME", help="drop one session")
    ss.add_argument("--forget-all", action="store_true", help="drop every session")
    ss.add_argument("--json", action="store_true")
    ss.set_defaults(fn=cmd_sessions)

    l = sub.add_parser("ledger", help="list past runs")
    l.add_argument("--limit", type=int, default=15)
    l.add_argument("--show", help="print run.json for a run whose name contains this")
    l.set_defaults(fn=cmd_ledger)

    args = p.parse_args()
    sys.exit(args.fn(args))


if __name__ == "__main__":
    main()
